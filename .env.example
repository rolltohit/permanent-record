# Supabase project settings → API Keys
# Optional for the group's own project: the app falls back to SUPABASE_URL, then
# to DEFAULT_SUPABASE_URL in src/lib/env.ts. Set it to point at another project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The anon key, or set NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (sb_publishable_...) instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only needed locally for the AI batch scripts and admin scripts.
# Never set this in Vercel and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: song.link (https://odesli.co) closed its free API on 2026-07-31. With a key,
# pasted links get exact matches on every platform; without one, links still work and
# platforms we can't match directly get a search link.
ODESLI_API_KEY=
