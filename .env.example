# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only needed locally for the AI batch scripts and admin scripts.
# Never set this in Vercel and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: raises the song.link rate limit (https://odesli.co)
ODESLI_API_KEY=
